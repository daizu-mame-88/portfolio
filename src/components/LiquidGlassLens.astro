---
// Apple Precision Optical Refraction Bevel Lens (Smooth Contour Bevel, Zero-Noise, Natural Optical Curvature)
---

<svg class="pointer-events-none fixed inset-0 w-0 h-0 overflow-hidden" aria-hidden="true">
    <defs>
        <!-- Natural Smooth Bevel Lens Refraction (Contour-based Smooth Displacement) -->
        <filter id="apple-liquid-lens" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
            <!-- 1. Smooth Bevel Heightmap from Element Contour -->
            <feGaussianBlur in="SourceAlpha" stdDeviation="5" result="smoothBevel" />
            
            <!-- 2. Pure Natural Lens Curvature (No noisy turbulence, perfectly smooth optical slope) -->
            <feDisplacementMap in="SourceGraphic" in2="smoothBevel" scale="14" xChannelSelector="A" yChannelSelector="A" result="naturalRefracted" />
            
            <feComposite in="naturalRefracted" in2="SourceGraphic" operator="over" />
        </filter>
    </defs>
</svg>
