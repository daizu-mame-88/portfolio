---
const links = [
    { name: "Apps", href: "/portfolio/#apps" },
    { name: "Blog", href: "/portfolio/blog" },
    { name: "About", href: "/portfolio/#about" },
];
---

<header
    class="fixed top-6 left-0 right-0 z-50 flex justify-center px-4 pointer-events-none"
>
    <div
        class="liquid-pill px-6 sm:px-8 py-3 rounded-full flex items-center justify-between gap-8 sm:gap-12 pointer-events-auto transition-all duration-300 max-w-fit"
    >
        <!-- Home / Brand -->
        <a
            href="/portfolio/"
            class="text-primary hover:opacity-75 transition-opacity font-bold tracking-tight text-sm flex items-center gap-2.5"
            aria-label="Home"
        >
            <span
                class="w-2.5 h-2.5 rounded-full bg-accent shadow-sm shadow-accent/50"
            ></span>
            <span class="tracking-tight font-semibold">Top</span>
        </a>

        <!-- Navigation Links -->
        <nav class="flex items-center gap-6 sm:gap-8">
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class="text-xs font-semibold text-secondary hover:text-primary transition-colors tracking-tight"
                    >
                        {link.name}
                    </a>
                ))
            }
        </nav>
    </div>
</header>
