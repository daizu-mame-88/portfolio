---
interface Props {
    title: string;
    date: Date;
    slug: string;
    tags?: string[];
}

const { title, date, slug, tags = [] } = Astro.props;
---

<a
    href={`/portfolio/blog/${slug}`}
    class="group block p-6 sm:p-7 rounded-[22px] transition-all duration-300 hover:bg-black/[0.03] dark:hover:bg-white/[0.04] active:scale-[0.99]"
>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex flex-col gap-2">
            <time
                datetime={date.toISOString()}
                class="text-xs text-secondary font-medium tracking-tight"
            >
                {
                    date
                        .toLocaleDateString("ja-JP", {
                            year: "numeric",
                            month: "2-digit",
                            day: "2-digit",
                        })
                        .replace(/\//g, ".")
                }
            </time>
            <h3 class="text-lg sm:text-xl font-semibold text-primary group-hover:text-accent transition-colors tracking-tight">
                {title}
            </h3>
        </div>

        {
            tags && tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 shrink-0">
                    {tags.map((tag) => (
                        <span class="text-xs font-medium px-2.5 py-0.5 rounded-full bg-black/[0.03] dark:bg-white/[0.05] text-secondary">
                            {tag}
                        </span>
                    ))}
                </div>
            )
        }
    </div>
</a>

