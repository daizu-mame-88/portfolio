---
interface Props {
    name: string;
    description: string;
    iconUrl: string;
    appStoreUrl: string;
    features?: string[];
    isFeatured?: boolean;
    rating?: number;
    ratingCount?: number;
    reviews?: {
        id: string;
        title: string;
        content: string;
        rating: number;
        author: string;
    }[];
}

const {
    name,
    description,
    iconUrl,
    appStoreUrl,
    features = [],
    isFeatured = false,
    rating,
    ratingCount,
    reviews = [],
} = Astro.props;
---

<div
    class="group relative bg-surface rounded-3xl p-10 border border-border transition-all duration-500 hover:shadow-2xl hover:shadow-accent/5 hover:-translate-y-1"
>
    <div class="flex flex-col md:flex-row items-start gap-8">
        {
            iconUrl && (
                <div class="w-24 h-24 md:w-28 md:h-28 shrink-0 rounded-[2rem] overflow-hidden shadow-sm border border-border group-hover:scale-105 transition-transform duration-700 ease-out">
                    <img
                        src={iconUrl}
                        alt={name}
                        class="w-full h-full object-cover"
                    />
                </div>
            )
        }
        <div class="flex-1 min-w-0">
            <div class="flex items-center gap-4 mb-4">
                <h3
                    class="text-2xl font-black text-primary group-hover:text-accent transition-colors tracking-[-0.05em]"
                >
                    {name}
                </h3>
                {
                    (rating && (ratingCount || 0) > 0 && (
                        <div class="flex items-center gap-1 bg-background/50 px-2 py-1 rounded-md border border-border">
                            <span class="text-orange-400">
                                <svg
                                    class="w-3.5 h-3.5 fill-current"
                                    viewBox="0 0 20 20"
                                >
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                </svg>
                            </span>
                            <span class="text-xs font-bold text-primary">
                                {rating.toFixed(1)}
                            </span>
                            <span class="text-[10px] text-secondary font-medium">
                                ({ratingCount})
                            </span>
                        </div>
                    )) || (
                        <div class="flex items-center gap-1 bg-background/50 px-2 py-1 rounded-md border border-border hidden"></div>
                    )
                }
            </div>
            <p
                class="text-secondary text-base leading-relaxed mb-8 font-medium tracking-tight line-clamp-3 min-h-[4.5em]"
            >
                {description}
            </p>

            {
                features && features.length > 0 && (
                    <ul class="flex flex-wrap gap-2.5 mb-8">
                        {features.map((feature: string) => (
                            <li class="text-[10px] font-bold px-3 py-1.5 bg-background/50 text-secondary rounded-full border border-border uppercase tracking-widest">
                                {feature}
                            </li>
                        ))}
                    </ul>
                )
            }

            {
                reviews && reviews.length > 0 && (
                    <div class="mb-8">
                        <h4 class="text-sm font-bold text-primary mb-3 flex items-center gap-2">
                            <span class="w-1 h-4 bg-accent rounded-full" />
                            What Users Say
                        </h4>
                        <div class="flex gap-4 overflow-x-auto pb-4 snap-x scrollbar-hide -mx-2 px-2 mask-linear">
                            {reviews.map((review) => (
                                <div class="snap-start shrink-0 w-64 bg-background/50 p-4 rounded-xl border border-border flex flex-col gap-2">
                                    <div class="flex items-center justify-between gap-2">
                                        <div class="flex text-orange-400">
                                            {Array.from({ length: 5 }).map(
                                                (_, i) => (
                                                    <svg
                                                        class={`w-3 h-3 ${i < review.rating ? "fill-current" : "text-border fill-transparent stroke-current"}`}
                                                        viewBox="0 0 20 20"
                                                    >
                                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                                    </svg>
                                                ),
                                            )}
                                        </div>
                                        <span class="text-[10px] text-secondary font-medium truncate max-w-[80px]">
                                            {review.author}
                                        </span>
                                    </div>
                                    <h5 class="text-sm font-bold text-primary line-clamp-1">
                                        {review.title}
                                    </h5>
                                    <p class="text-xs text-secondary line-clamp-3 leading-relaxed">
                                        {review.content}
                                    </p>
                                </div>
                            ))}
                        </div>
                    </div>
                )
            }

            <a
                href={appStoreUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm font-bold text-primary border-b-2 border-primary pb-1 hover:opacity-70 transition-opacity uppercase tracking-widest"
            >
                View App
                <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
                >
            </a>
        </div>
    </div>
</div>
