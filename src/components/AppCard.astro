---
interface Props {
    name: string;
    description: string;
    iconUrl: string;
    appStoreUrl: string;
    features?: string[];
    isFeatured?: boolean;
    rating?: number;
    ratingCount?: number;
    downloads?: number;
    reviews?: {
        id: string;
        title: string;
        content: string;
        rating: number;
        author: string;
    }[];
}

const {
    name,
    description,
    iconUrl,
    appStoreUrl,
    features = [],
    isFeatured = false,
    rating,
    ratingCount,
    downloads,
    reviews = [],
} = Astro.props;
---

<div class="liquid-card group relative flex flex-col justify-between">
    <div>
        <!-- App Header: Icon + Info -->
        <div class="flex items-start gap-5 sm:gap-6 mb-6">
            {
                iconUrl && (
                    <div class="w-20 h-20 sm:w-24 sm:h-24 shrink-0 rounded-[22%] overflow-hidden shadow-lg shadow-black/5 dark:shadow-black/40 group-hover:scale-105 transition-transform duration-500 ease-out">
                        <img
                            src={iconUrl}
                            alt={name}
                            class="w-full h-full object-cover"
                            loading="lazy"
                        />
                    </div>
                )
            }
            <div class="flex-1 min-w-0 pt-1">
                <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-primary mb-2">
                    {name}
                </h3>


                <!-- Stats: Rating & Downloads (Liquid Pills) -->
                <div class="flex flex-wrap items-center gap-2">
                    {
                        rating && (ratingCount || 0) > 0 && (
                            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full liquid-pill text-xs font-semibold text-primary">
                                <span class="text-amber-500 flex items-center">
                                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                    </svg>
                                </span>
                                <span>{rating.toFixed(1)}</span>
                                <span class="text-[11px] text-secondary font-normal">
                                    ({ratingCount})
                                </span>
                            </div>
                        )
                    }
                    {
                        downloads && downloads >= 1000 && (
                            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full liquid-pill text-xs font-semibold text-primary">
                                <span class="text-accent flex items-center">
                                    <svg class="w-3.5 h-3.5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                                    </svg>
                                </span>
                                <span>
                                    {downloads >= 50000 ? (Math.floor(downloads / 10000) + '万+ DL') : (`${downloads.toLocaleString()} DL`)}
                                </span>
                            </div>
                        )
                    }
                </div>
            </div>
        </div>

        <!-- Description -->
        <p class="text-secondary text-base sm:text-lg leading-relaxed mb-6 font-normal tracking-tight line-clamp-3 relative z-10">
            {description}
        </p>

        <!-- Features (Liquid Micro Pills) -->
        {
            features && features.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-6 relative z-10">
                    {features.map((feature: string) => (
                        <span class="text-xs font-medium px-3 py-1 rounded-full liquid-pill text-secondary">
                            {feature}
                        </span>
                    ))}
                </div>
            )
        }

        <!-- User Reviews Horizontal Stream -->
        {
            reviews && reviews.length > 0 && (
                <div class="mb-6 relative z-10">
                    <div class="flex gap-3 overflow-x-auto pb-3 snap-x scrollbar-none -mx-2 px-2">
                        {reviews.map((review) => (
                            <div class="snap-start shrink-0 w-64 p-4 rounded-2xl liquid-pill flex flex-col gap-2">
                                <div class="flex items-center justify-between gap-2">
                                    <div class="flex text-amber-500">
                                        {Array.from({ length: 5 }).map((_, i) => (
                                            <svg
                                                class={`w-3 h-3 ${i < review.rating ? "fill-current" : "opacity-20 fill-current"}`}
                                                viewBox="0 0 20 20"
                                            >
                                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                            </svg>
                                        ))}
                                    </div>
                                    <span class="text-[11px] text-secondary truncate max-w-[90px]">
                                        {review.author}
                                    </span>
                                </div>
                                <h4 class="text-xs font-semibold text-primary line-clamp-1">
                                    {review.title}
                                </h4>
                                <p class="text-xs text-secondary line-clamp-2 leading-relaxed">
                                    {review.content}
                                </p>
                            </div>
                        ))}
                    </div>
                </div>
            )
        }
    </div>

    <!-- Actions -->
    <div class="pt-4 flex items-center justify-between gap-4 relative z-10">
        <a
            href={appStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-apple-primary text-xs"
        >
            <span>App Storeで見る</span>
            <svg
                class="w-3.5 h-3.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                />
            </svg>
        </a>
    </div>
</div>


