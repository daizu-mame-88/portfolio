---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

type Props = {
    post: CollectionEntry<"blog">;
};

export async function getStaticPaths() {
    const posts = await getCollection("blog", ({ data }) => {
        return data.visibility === "public";
    });
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props as Props;
const { Content } = await post.render();
---

<Layout title={`${post.data.title} | SHUYA KOMIYA`} description={post.data.description}>
    <div class="container-custom pb-32">
        <div class="max-w-3xl mx-auto">
            <!-- Back Link -->
            <a
                href="/portfolio/blog"
                class="inline-flex items-center gap-2 text-secondary hover:text-primary transition-colors mb-12 text-xs font-semibold tracking-tight group"
            >
                <svg
                    class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-1"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"
                    />
                </svg>
                <span>Journal</span>
            </a>

            <article class="reveal-on-scroll">
                <header class="mb-12 md:mb-16">
                    <time
                        datetime={post.data.pubDate.toISOString()}
                        class="text-xs text-secondary font-medium tracking-tight block mb-4"
                    >
                        {
                            post.data.pubDate
                                .toLocaleDateString("ja-JP", {
                                    year: "numeric",
                                    month: "2-digit",
                                    day: "2-digit",
                                })
                                .replace(/\//g, ".")
                        }
                    </time>
                    <h1 class="heading-hero mb-6">{post.data.title}</h1>

                    {
                        post.data.tags && post.data.tags.length > 0 && (
                            <div class="flex flex-wrap gap-2">
                                {post.data.tags.map((tag) => (
                                    <a
                                        href={`/portfolio/blog/tag/${tag}`}
                                        class="text-xs font-medium px-3 py-1 rounded-full liquid-pill text-secondary hover:text-primary transition-colors"
                                    >
                                        #{tag}
                                    </a>
                                ))}
                            </div>
                        )
                    }
                </header>

                <div
                    class="prose prose-slate dark:prose-invert prose-lg max-w-none leading-relaxed tracking-tight"
                >
                    <Content />
                </div>

                <div class="mt-20 pt-10 flex items-center justify-between">
                    <a
                        href="/portfolio/blog"
                        class="btn-apple-secondary text-xs"
                    >
                        <span>記事一覧に戻る</span>
                    </a>
                </div>
            </article>
        </div>
    </div>
</Layout>

